# ─────────────────────────────────────────────
# SALEIA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env com valores reais
# ─────────────────────────────────────────────

# ── OpenAI (obrigatório) ──────────────────────
OPENAI_API_KEY=sk-...sua_chave_aqui

# ── Notificação WhatsApp (Z-API) ──────────────
ZAPI_INSTANCE=seu_instance_id
ZAPI_TOKEN=seu_token
ZAPI_PHONE=5511999999999

# ── Notificação E-mail (SMTP / Gmail) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_app
EMAIL_VENDEDOR=vendedor@email.com

# ── Tactiq ────────────────────────────────────
# Secret opcional para validar autenticidade do webhook
TACTIQ_WEBHOOK_SECRET=seu_secret_opcional
# Chave de API do Tactiq (apenas planos pagos — para polling em tempo real)
TACTIQ_API_KEY=

# ── Configurações do servidor ─────────────────
# URL base do servidor (usada nos links dos relatórios)
BASE_URL=https://seuservidor.com
# Origens CORS permitidas (separadas por vírgula, ou * para todas)
CORS_ORIGINS=*
