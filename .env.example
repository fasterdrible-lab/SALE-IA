# .env.example — Variáveis de ambiente do SALEIA
# Copie este arquivo para .env e preencha suas chaves
# cp .env.example .env

# ─── OpenAI (obrigatório se usar GPT-4o ou GPT-4o-mini) ──────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ─── Anthropic (Claude) — opcional ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Google (Gemini) — opcional ───────────────────────────────────────────────
GOOGLE_API_KEY=AIza-your-key-here

# ─── Groq — transcrição de áudio (opcional, alternativa ao Whisper) ──────────
GROQ_API_KEY=gsk_your-key-here
# whisper (padrão) | groq
TRANSCRICAO_PROVEDOR=whisper

# ─── Propensão de Compra — limiares de classificação (opcional) ──────────────
# score_compra (0-100) >= LIMIAR_ALTA          -> alta
# LIMIAR_MEDIA <= score_compra < LIMIAR_ALTA    -> media
# score_compra < LIMIAR_MEDIA                   -> baixa
PROPENSAO_LIMIAR_ALTA=70
PROPENSAO_LIMIAR_MEDIA=45

# ==================================================
# EMBEDDINGS / RAG
# ==================================================
# Provedor usado para gerar embeddings do RAG (base_conhecimento) e do
# Sales Memory (sales_memories). Nenhum módulo de negócio depende
# diretamente de OpenAI ou Ollama — a seleção acontece só aqui.
# ollama (padrão, 100% local — nada sai da máquina) | openai
EMBEDDING_PROVIDER=ollama

# ─── Ollama local ──────────────────────────────────────────────────────────
# URL do servidor Ollama (padrão: instalação local)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de embedding a usar — precisa ser baixado antes: ollama pull embeddinggemma
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# ─── OpenAI (opcional, usa a mesma OPENAI_API_KEY acima) ───────────────────
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Processamento em lote ───────────────────────────────────────────────────
# Quantos embeddings processar/concorrer por vez (reindex + geração em lote)
EMBEDDING_BATCH_SIZE=32
# Timeout em segundos por chamada de embedding
EMBEDDING_TIMEOUT=30

# ─── Fallback opcional ───────────────────────────────────────────────────────
# Vazio = sem fallback (padrão). Só é usado se explicitamente configurado
# (ex.: "openai") — nunca envia dados a outro provedor silenciosamente.
EMBEDDING_FALLBACK_PROVIDER=

# ─── SMTP — recuperação de senha ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-google
EMAIL_FROM=noreply@saleia.com.br
APP_BASE_URL=https://api.saleia.com.br

# ─── Claude Account Mode — piloto "conta Claude do usuário" ─────────────────
# Ativa os endpoints /claude-account/* (cada vendedor usa a própria conta
# Claude Pro/Max). Desativado por padrão — nada muda se você não mexer aqui.
CLAUDE_ACCOUNT_PILOT=false
# Chave para criptografar o token da conta Claude de cada usuário em repouso.
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAUDE_TOKEN_ENC_KEY=
# Opcional: caminho absoluto do binário `claude` (@anthropic-ai/claude-code),
# só necessário se o serviço systemd não achar o binário via PATH.
CLAUDE_CLI_PATH=

# ─── Observabilidade — alertas Telegram (Fase 1) ─────────────────────────────
# 1. Crie um bot via @BotFather no Telegram → obtenha TELEGRAM_TOKEN
# 2. Envie uma mensagem para o bot e acesse:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copie o chat_id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
